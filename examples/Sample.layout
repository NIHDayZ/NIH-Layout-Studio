FrameWidgetClass Root {
 position 0 0
 size 1 1
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 {
  PanelWidgetClass ExamplePanel {
   position 0.5 0.5
   size 420 180
   halign center_ref
   valign center_ref
